#!/bin/bash
# After Organizer ▸ Distribute ▸ Direct Distribution: zip the notarized, stapled app for release and test what a
# download of that zip will be: the Release test plan on the unzipped copy as an export (Gatekeeper and the stapled
# ticket besides the signature, slice, entitlement, closure, hygiene and identity checks and the built-in iPod's boot).
#
#     scripts/check-export "path/to/Light Touch.app"
#
# Writes LightTouchMac-universal.zip (the release download) and SHA256SUMS naming it beside the app. Exit 1 on any failure.
set -euo pipefail
APP="${1:?usage: scripts/check-export path/to/Light Touch.app}"
APP="$(cd "$(dirname "$APP")" && pwd)/$(basename "$APP")"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$(dirname "$APP")"
ZIP="$OUT/LightTouchMac-universal.zip"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/ltm-check-export.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

rm -f "$ZIP"
ditto -c -k --keepParent "$APP" "$ZIP"
ditto -x -k "$ZIP" "$WORK"
TEST_RUNNER_LTM_RELEASE_APP="$WORK/$(basename "$APP")" TEST_RUNNER_LTM_RELEASE_EXPORTED=1 \
    xcodebuild -quiet -skipMacroValidation -workspace "$ROOT/LightTouchMac.xcworkspace" -scheme LightTouchMac -testPlan Release \
    -derivedDataPath "$WORK/dd" test || { echo "FAILED: the Release tests on the unzipped export" >&2; exit 1; }
(cd "$OUT" && shasum -a 256 "$(basename "$ZIP")" > SHA256SUMS)
echo "ok: $ZIP"
cat "$OUT/SHA256SUMS"
