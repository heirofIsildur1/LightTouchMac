#!/bin/bash
# A fresh Mac to a first build: checks what scripts/vendor and Xcode need, prints each missing piece and where to get
# it, then runs scripts/vendor. Nothing here downloads or copies Apple's software or firmware.
#
#     scripts/bootstrap            check, then scripts/vendor
#     scripts/bootstrap --check    check only (exit 1 if anything is missing)
#
# The inputs are scripts/vendor's (Packages/BuildTools/Sources/BuildTools/Vendor.swift), its recipes'
# (scripts/build-*.sh, qemu-ios contrib/export-guest-artifacts.sh) and the pins (build-support/sources.json).
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# The pre-commit formatter (scripts/hooks/pre-commit) and blame's skip list of reformat commits (optional: a worktree
# on an older branch has none, and blame would fail without the file).
git -C "$ROOT" config core.hooksPath scripts/hooks &&
    git -C "$ROOT" config blame.ignoreRevsFile ':(optional).git-blame-ignore-revs'
missing=0
need() { missing=1; printf 'missing: %s\n    %s\n' "$1" "$2"; }

[[ "$(uname -m)" == arm64 ]] || need "an Apple Silicon Mac" "the native recipes build both slices from arm64"

version="$(xcodebuild -version 2>/dev/null | sed -n 's/^Xcode \([0-9]*\).*/\1/p')"
if [[ -z "$version" ]]; then
    need "Xcode (xcode-select -p is $(xcode-select -p 2>/dev/null || echo unset))" \
        "install Xcode 27 or later from the App Store or developer.apple.com, then: sudo xcode-select -s /Applications/Xcode.app"
elif ((version < 27)); then
    need "Xcode 27 or later (found $version)" "developer.apple.com/download/all, then sudo xcode-select -s that Xcode"
fi
xcrun --sdk macosx --show-sdk-path >/dev/null 2>&1 || need "the macOS SDK" "xcode-select --install; open Xcode once to finish its setup"

# tool:Homebrew formula (curl, make, file, lipo and xcrun come with macOS and Xcode)
formulas=()
for pair in pkg-config:pkgconf ninja:ninja meson:meson glibtoolize:libtool autoreconf:autoconf automake:automake \
    python3.12:python@3.12 jq:jq ldid:ldid; do
    command -v "${pair%%:*}" >/dev/null || formulas+=("${pair#*:}")
done
if ((${#formulas[@]})); then
    command -v brew >/dev/null || need "Homebrew" "https://brew.sh"
    need "build tools: ${formulas[*]}" "brew install ${formulas[*]}"
fi

pin() { plutil -extract "$1.$2" raw -o - "$ROOT/build-support/sources.json"; }
for name in qemu-ios usbmuxd; do
    env="QEMU_IOS_DIR"; [[ $name == usbmuxd ]] && env="USBMUXD_SOURCE_DIR"
    dir="${!env:-$(pin "$name" path)}"; dir="${dir/#\~/$HOME}"
    commit="$(pin "$name" commit)"
    if ! git -C "$dir" cat-file -e "$commit^{commit}" 2>/dev/null; then
        need "$name at $commit in $dir ($env moves it)" \
            "git clone -b $(pin "$name" branch) $(pin "$name" repository) $dir  (or git -C $dir fetch)"
    fi
done

sdk="${ARMV6_SDK:-$HOME/Developer/ipod2g-re/OldSDK/iPhoneOS3.1.3.sdk}"
[[ -f "$sdk/usr/lib/libSystem.dylib" ]] || need "the iPhoneOS 3.1.3 SDK at $sdk (ARMV6_SDK)" \
    "Apple's \"iPhone SDK 3.1.3 with Xcode 3.1.4\" disk image (developer.apple.com/download/all): its iPhoneOS3.1.3.sdk"
assets="${LTM_ASSETS:-$HOME/Developer/qemu-ios-files}"
ipad="${IPAD_SDK:-$HOME/Developer/qemu-ios-files/ipad1/sdk/x-iPhoneSDK3_2_2/Payload/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS3.2.sdk}"
[[ -f "$ipad/usr/lib/libSystem.dylib" ]] || need "the iPhoneOS 3.2 SDK at $ipad (IPAD_SDK)" \
    "Apple's \"Xcode 3.2.2 and iPhone SDK 3.2\" disk image (developer.apple.com/download/all): its iPhoneOS3.2.sdk"
for rom in bootrom_240_4 ipod1g/bootrom_s5l8900; do
    [[ -f "$assets/$rom" ]] || need "the SecureROM $assets/$rom (LTM_ASSETS)" \
        "a dump of the device's own SecureROM (iPod touch 2G: 240.4; iPod touch 1G: S5L8900); never in a repository"
done

entry="$(grep -A8 '"id": "n72ap-7E18"' "$ROOT/LightTouchMac/Resources/firmware-catalog.json")"
sha1="$(sed -n 's/.*"source": {[^}]*"sha1": "\([0-9a-f]*\)".*/\1/p' <<<"$entry" | head -1)"
url="$(sed -n 's/.*"source": {"kind": "ipsw", "url": "\([^"]*\)".*/\1/p' <<<"$entry" | head -1)"
ipsw="${LTM_BUILT_IN_IPSW:-$HOME/Library/Caches/gold.samhenri.LightTouchMac/IPSW/$sha1.ipsw}"
[[ -f "$ipsw" ]] || need "the iPod touch 2G 3.1.3 (n72ap-7E18) IPSW at $ipsw (LTM_BUILT_IN_IPSW)" \
    "download it in Light Touch, or: mkdir -p \"$(dirname "$ipsw")\" && curl -L -o \"$ipsw\" $url  (sha1 $sha1)"

if ((missing)); then
    echo "bootstrap: install the above, then run scripts/bootstrap again"
    exit 1
fi
echo "bootstrap: everything scripts/vendor needs is here"
[[ "${1:-}" == --check ]] && exit 0
exec "$ROOT/scripts/vendor"
