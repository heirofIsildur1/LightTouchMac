#!/bin/bash
# Writes Packages/HostRuntime/Sources/HostRuntime/MachineOptions.swift, the -machine options each board's machine
# declares, from a qemu-ios build's qemu-system-arm (qom-list-properties of each machine type in
# tests/fixtures/machines.json: class and instance properties both). A boot passes no other (PreparedDeviceBoot), so
# run this when the qemu-ios pin moves and commit what `git diff` shows.
#
#     scripts/machine-options [qemu-system-arm]     default: the pinned checkout's build (scripts/sources qemu-build)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
QEMU="${1:-$("$ROOT/scripts/sources" qemu-build)/qemu-system-arm}"
OUT="$ROOT/Packages/HostRuntime/Sources/HostRuntime/MachineOptions.swift"
/usr/bin/python3 -I - "$QEMU" "$ROOT/tests/fixtures/machines.json" "$OUT" <<'EOF'
import json, subprocess, sys
qemu, fixture, out = sys.argv[1:]
machines = sorted((m["board"], m["machine"]) for m in json.load(open(fixture)))
qmp = [{"execute": "qmp_capabilities"}]
qmp += [{"execute": "qom-list-properties", "arguments": {"typename": f"{m}-machine"}} for _, m in machines]
qmp += [{"execute": "quit"}]
run = subprocess.run([qemu, "-M", "none", "-display", "none", "-nodefaults", "-qmp", "stdio"],
                     input="".join(json.dumps(c) + "\n" for c in qmp), capture_output=True, text=True, check=True)
replies = [r["return"] for r in map(json.loads, run.stdout.splitlines()) if isinstance(r.get("return"), list)]
if len(replies) != len(machines):
    sys.exit(f"machine-options: {len(replies)} property lists for {len(machines)} machines\n{run.stdout}{run.stderr}")
lines = [
    "// The -machine options each board's machine declares: generated by scripts/machine-options from qemu-ios's",
    "// qom-list-properties of each machine type. Run it again when the qemu-ios pin moves.",
    "",
    "extension Board {",
    "    /// The -machine options this board's machine declares; a boot passes no other (PreparedDeviceBoot).",
    "    public var machineOptions: Set<String> { declaredMachineOptions[rawValue] ?? [] }",
    "}",
    "",
    "private let declaredMachineOptions: [String: Set<String>] = [",
]
for (board, _), properties in zip(machines, replies):
    lines.append(f'    "{board}": [')
    lines += [f'        "{name}",' for name in sorted({p["name"] for p in properties} - {"type"})]
    lines.append("    ],")
lines.append("]")
open(out, "w").write("\n".join(lines) + "\n")
EOF
echo "$OUT"
