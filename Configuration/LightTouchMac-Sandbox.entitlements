<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The app with a sandboxed helper (LTM_HELPER_SANDBOX = YES): the helper's app group, so the app makes the group's
     container and the sockets in it as its own (HostRuntime HelperSandbox). Location as ENABLE_RESOURCE_ACCESS_LOCATION
     gives the app without this file. The app itself is not sandboxed. -->
<dict>
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>SM75355Y6R.ltm</string>
    </array>
</dict>
</plist>
