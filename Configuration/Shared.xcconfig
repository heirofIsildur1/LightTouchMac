// Shared by Debug and Release. Keep the app and packaged native libraries on
// the same minimum macOS version.
MACOSX_DEPLOYMENT_TARGET = 14.4

// The pinned qemu-ios checkout and its development build (build-support/sources.json: "path" and
// "build_dir"). A Debug helper loads libqemu-arm.dylib from there (its rpath) unless LTM_QEMU_DYLIB names
// another; a release loads only the one Archive copies into Contents/Frameworks.
QEMU_IOS_DIR = $(HOME)/Developer/qemu-ios-ipad1
QEMU_BUILD_DIR = $(QEMU_IOS_DIR)/build-w1-native

// scripts/vendor's directory for the current pins: what Archive copies into the app (Frameworks, the tools in
// MacOS, Resources/Guest, Device and licenses) and the libimobiledevice headers and libraries the services helper
// links. The services helper's first phase (scripts/vendor-check) points the gitignored build/vendor at the current
// pins' directory, or fails the build saying to run scripts/vendor. Local.xcconfig (gitignored) may set VENDOR_DIR
// or anything else here; the check holds an overridden VENDOR_DIR to the current pins too.
VENDOR_DIR = $(SRCROOT)/build/vendor

// The build number (CFBundleVersion) is the commit count, stamped into the app's Info.plist by its
// "Build Number" phase at every build; this is only what the helpers' embedded Info.plists carry.
CURRENT_PROJECT_VERSION = 1

LD_RUNPATH_SEARCH_PATHS = $(inherited) "@executable_path/../Frameworks"
LD_RUNPATH_SEARCH_PATHS[config=Debug] = $(inherited) "@executable_path/../Frameworks" "$(QEMU_BUILD_DIR)" "$(VENDOR_DIR)/Frameworks"

#include? "Local.xcconfig"
