// The Light Touch app target, on top of Shared.xcconfig (the project's settings).

PRODUCT_BUNDLE_IDENTIFIER = gold.samhenri.LightTouchMac
EXECUTABLE_NAME = LightTouch
MARKETING_VERSION = 1.0
INFOPLIST_FILE = Configuration/LightTouchMac-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Light Touch
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = © Sam Henri Gold, 2026
INFOPLIST_KEY_NSLocalNetworkUsageDescription = A device you attach to the local network can reach the computers and accessories on it, and Play on Phone shows a device on a phone there.
INFOPLIST_KEY_NSLocationUsageDescription = Puts a device’s GPS where this Mac is.
INFOPLIST_KEY_NSPrincipalClass = LightTouchApplication
INFOPLIST_KEY_NSViewGestureRecognizerIsExclusive = NO

// The sandbox entitlements only with LTM_HELPER_SANDBOX = YES (Shared.xcconfig).
CODE_SIGN_ENTITLEMENTS = $(LTM_APP_ENTITLEMENTS_$(LTM_HELPER_SANDBOX))
ENABLE_APP_SANDBOX = NO
REGISTER_APP_GROUPS = YES
AUTOMATION_APPLE_EVENTS = NO
ENABLE_RESOURCE_ACCESS_AUDIO_INPUT = NO
ENABLE_RESOURCE_ACCESS_CALENDARS = NO
ENABLE_RESOURCE_ACCESS_CAMERA = NO
ENABLE_RESOURCE_ACCESS_CONTACTS = NO
ENABLE_RESOURCE_ACCESS_LOCATION = YES
ENABLE_RESOURCE_ACCESS_PHOTO_LIBRARY = NO
OTHER_SWIFT_STDLIB_TOOL_FLAGS = --scan-folder "$(TARGET_BUILD_DIR)/$(EXECUTABLE_FOLDER_PATH)" --Xcodesign --options=runtime

// The Build Number and vendor copy phases read the checkout and write outside the build directory.
ENABLE_USER_SCRIPT_SANDBOXING = NO

ASSETCATALOG_COMPILER_APPICON_NAME = LightTouch
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
COMBINE_HIDPI_IMAGES = YES
STRING_CATALOG_GENERATE_SYMBOLS = NO
SWIFT_EMIT_LOC_STRINGS = NO
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
