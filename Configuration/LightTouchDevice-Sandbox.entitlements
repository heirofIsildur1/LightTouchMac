<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The device helper under the App Sandbox (LTM_HELPER_SANDBOX = YES, Configuration/Shared.xcconfig, the
     default). allow-jit as LightTouchDevice.entitlements. No file exceptions: whoever spawns it grants its device's
     files (HostRuntime SandboxExtension). network.client and .server: slirp, the web proxy's upstream and its
     loopback egress. The app group: the rendezvous Mach name and the folder its Unix sockets are in (HostRuntime
     HelperSandbox); the app is signed with it too (LightTouchMac-Sandbox.entitlements). -->
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>SM75355Y6R.ltm</string>
    </array>
</dict>
</plist>
