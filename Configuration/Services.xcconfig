// The LightTouchServices helper target, on top of Shared.xcconfig (the project's settings).

PRODUCT_BUNDLE_IDENTIFIER = gold.samhenri.LightTouchMac.LightTouchServices
CODE_SIGN_ENTITLEMENTS = Configuration/Tool.entitlements
SKIP_INSTALL = YES
ENABLE_DEBUG_DYLIB = NO
SWIFT_OBJC_BRIDGING_HEADER = LightTouchServices/Lockdown/Lockdown.h
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES

// libimobiledevice from the vendor directory; its Vendor Directory phase (scripts/vendor-check) writes build/vendor.
HEADER_SEARCH_PATHS = $(VENDOR_DIR)/include
LIBRARY_SEARCH_PATHS = $(VENDOR_DIR)/Frameworks
OTHER_LDFLAGS = -limobiledevice-1.0 -lplist-2.0
ENABLE_USER_SCRIPT_SANDBOXING = NO
