+/* A binary plist's objects can be referenced from many places and each reference becomes its own copy, so a few
+ * hundred bytes of shared references stand for a tree of billions of nodes. One parse makes at most this many nodes
+ * and copies at most this many string, data and key bytes. */
+#ifndef PLIST_BIN_MAX_NODES
+#define PLIST_BIN_MAX_NODES (1 << 20)
+#endif
+#ifndef PLIST_BIN_MAX_BYTES
+#define PLIST_BIN_MAX_BYTES (32 << 20)
+#endif
 
