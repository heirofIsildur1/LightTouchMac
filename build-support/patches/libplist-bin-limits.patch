+        uint64_t copied = (size > PLIST_BIN_MAX_BYTES) ? PLIST_BIN_MAX_BYTES + 1 : size * (type == BPLIST_UNICODE ? 3 : 1);
+        bplist->bytes += copied;
+    }
+    if (++bplist->nodes > PLIST_BIN_MAX_NODES || bplist->bytes > PLIST_BIN_MAX_BYTES) {
